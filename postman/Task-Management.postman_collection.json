{
  "info": { "name": "Task Management API", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json" },
  "variable": [{ "key": "baseUrl", "value": "http://localhost:8080" }, { "key": "token", "value": "" }],
  "item": [
    { "name": "Health", "request": { "method": "GET", "url": "{{baseUrl}}/health" } },
    { "name": "Register", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"name\":\"Demo User\",\"email\":\"demo@example.com\",\"password\":\"correct-horse-1\"}" }, "url": "{{baseUrl}}/api/v1/auth/register" } },
    { "name": "Login", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\":\"demo@example.com\",\"password\":\"correct-horse-1\"}" }, "url": "{{baseUrl}}/api/v1/auth/login" } },
    { "name": "Create project", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }], "body": { "mode": "raw", "raw": "{\"name\":\"Demo project\",\"description\":\"Sample project\"}" }, "url": "{{baseUrl}}/api/v1/projects" } },
    { "name": "List projects", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/v1/projects?page=1&page_size=20" } }
  ]
}
